{
  "name": "app-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Every method and event of @pithyx/sdk and every component of @pithyx/ui in one Pithyx app, to try them on a box.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build && pithyx validate && vitest run",
    "pack": "npm run build && pithyx pack"
  },
  "dependencies": {
    "@pithyx/sdk": "1.0.0-rc.9",
    "@pithyx/ui": "1.0.0-rc.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pithyx/cli": "1.0.0-rc.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
